# =============================================================================
# 前端AI发消息 — 环境变量示例
# 使用方法：复制为 .env 并填入真实值
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =============================================================================

# --- 必填 ---
ZHIPUAI_API_KEY=your_zhipu_api_key_here

# --- Web 服务 ---
APP_HOST=0.0.0.0
APP_PORT=5001
# 兼容旧变量名（仍可读）：FLASK_HOST / FLASK_PORT

# --- MCP 工具服务（微信/邮件/搜索/文件等）---
MCP_HOST=localhost
MCP_PORT=8090

# --- PostgreSQL（聊天持久化 + LangGraph Checkpointer，可选但推荐）---
# 未配置时部分功能降级为内存模式
POSTGRES_URI=postgresql://user:password@127.0.0.1:5432/ai_chat

# --- Redis（聊天热缓存 + Task Harness 元数据）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- Milvus 向量库（RAG / GraphRAG）---
MILVUS_URI=http://127.0.0.1:19530
RAG_ENABLED=1
RAG_EMBEDDING_MODEL=embedding-3
RAG_EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_HYBRID_ENABLED=1
DEFAULT_RAG_MODE=rag

# --- Neo4j 图谱（GraphRAG，可选）---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
GRAPHRAG_ENABLED=1
GRAPHRAG_TOP_K=8
GRAPHRAG_GRAPH_HOPS=2

# --- 联网搜索（MCP web_search，可选）---
TAVILY_API_KEY=your_tavily_api_key_here

# --- 邮件发送（MCP send_email，可选）---
EMAIL_ADDRESS=your_email@163.com
EMAIL_PASSWORD=your_smtp_auth_code
SMTP_SERVER=smtp.163.com
SMTP_PORT=465

# --- Agent / Task Harness ---
AGENT_TASK_HARNESS=1
AGENT_TASK_HARNESS_MIN_SIGNALS=1
AGENT_LLM_CONTEXT_MESSAGES=10
AGENT_REANCHOR_EVERY_N_TOOLS=3
AGENT_RECURSION_LIMIT=100
AGENT_PHASE_GATE_MAX_RETRIES=3
MAX_TASK_CONTINUATIONS=5

# --- HITL 人机确认（需 POSTGRES_URI + AGENT_CHECKPOINT_ENABLED）---
HITL_ENABLED=1
AGENT_CHECKPOINT_ENABLED=1

# --- 聊天摘要（长对话压缩）---
CHAT_SUMMARY_ENABLED=1
CHAT_SUMMARY_ROUNDS=20
CHAT_HISTORY_MAX_MESSAGES=500
CHAT_AGENT_CONTEXT_MESSAGES=80

# --- API 限流（智谱 Embedding / LLM）---
API_REQUEST_INTERVAL_SEC=0
API_RETRY_MAX=5
API_RETRY_BASE_SEC=2.0

# --- 日志 ---
LOG_LLM_PROMPT=1
LOG_LLM_PROMPT_MAX=12000

# --- LangSmith 可观测性（Agent 执行追踪，可选）---
# 在 https://smith.langchain.com 创建 API Key 后填入
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=my_agent
LANGSMITH_TRACING=1
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WEB_URL=https://smith.langchain.com
